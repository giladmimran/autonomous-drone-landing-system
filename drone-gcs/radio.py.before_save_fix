import threading
import time
from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from pymavlink import mavutil

PORT = "/dev/ttyACM0"
BAUD = 115200

app = FastAPI()
lock = threading.RLock()
send_lock = threading.Lock()
param_condition = threading.Condition()
param_values = {}

master = None
state = {
    "connected": False,
    "armed": False,
    "channels": [0] * 16,
    "count": 0,
    "last_update": 0,
    "error": "Connecting...",
    "phase": "idle",
    "minimum": [None] * 16,
    "maximum": [None] * 16,
    "trim": [None] * 16,
    "saved": False,
    "message": ""
}

def worker():
    global master
    while True:
        try:
            if master is None:
                state["connected"] = False
                master = mavutil.mavlink_connection(PORT, baud=BAUD)
                master.wait_heartbeat(timeout=15)
                state["connected"] = True
                state["error"] = ""
                print("Pixhawk heartbeat received")

            msg = master.recv_match(
                type=["HEARTBEAT", "RC_CHANNELS", "PARAM_VALUE"],
                blocking=True,
                timeout=2
            )

            if msg is None:
                continue

            if msg.get_type() == "HEARTBEAT":
                state["armed"] = bool(
                    msg.base_mode & mavutil.mavlink.MAV_MODE_FLAG_SAFETY_ARMED
                )

            elif msg.get_type() == "PARAM_VALUE":
                raw_id = msg.param_id
                name = (
                    raw_id.decode("ascii", errors="ignore").rstrip("\x00")
                    if isinstance(raw_id, (bytes, bytearray))
                    else str(raw_id).rstrip("\x00")
                )
                print(
                    "PARAM_VALUE RECEIVED:",
                    repr(msg.param_id),
                    "value=", msg.param_value,
                    "type=", type(msg.param_id).__name__
                )
                with param_condition:
                    param_values[name] = float(msg.param_value)
                    param_condition.notify_all()

            elif msg.get_type() == "RC_CHANNELS":
                values = [
                    getattr(msg, f"chan{i}_raw", 0)
                    for i in range(1, 17)
                ]
                with lock:
                    state["channels"] = values
                    state["count"] = min(6, msg.chancount)
                    state["last_update"] = time.time()

                    if state["phase"] == "capture":
                        for i, value in enumerate(values[:state["count"]]):
                            if 800 <= value <= 2200:
                                lo = state["minimum"][i]
                                hi = state["maximum"][i]
                                state["minimum"][i] = value if lo is None else min(lo, value)
                                state["maximum"][i] = value if hi is None else max(hi, value)

        except Exception as e:
            print("MAVLink error:", e)
            state["connected"] = False
            state["error"] = str(e)
            master = None
            time.sleep(2)

threading.Thread(target=worker, daemon=True).start()

@app.get("/api/radio")
def status():
    with lock:
        return {
            **state,
            "signal": time.time() - state["last_update"] < 2
        }

@app.post("/api/start")
def start():
    if not state["connected"]:
        raise HTTPException(503, "Pixhawk is not connected")
    if state["armed"]:
        raise HTTPException(400, "Disarm the vehicle first")

    with lock:
        state["minimum"] = [None] * 16
        state["maximum"] = [None] * 16
        state["trim"] = [None] * 16
        state["saved"] = False
        state["message"] = "Move every stick, switch and knob through its full range."
        state["phase"] = "capture"

    return {"ok": True}

@app.post("/api/finish")
def finish():
    with lock:
        if state["phase"] != "capture":
            raise HTTPException(400, "Start calibration first")

        count = state["count"]
        mins = state["minimum"][:count]
        maxs = state["maximum"][:count]

        for i, (lo, hi) in enumerate(zip(mins, maxs)):
            if lo is None or hi is None or hi - lo < 100:
                raise HTTPException(
                    400,
                    f"Channel {i+1} has insufficient movement. Move it through its full range."
                )

        state["phase"] = "trim"
        state["message"] = "Centre all sticks and switches. Keep throttle fully DOWN, then press Save."
    return {"ok": True}


def set_parameter(name, value):
    global master

    if master is None or not state["connected"]:
        return False

    with param_condition:
        param_values.pop(name, None)

    with send_lock:
        master.mav.param_set_send(
            master.target_system,
            master.target_component,
            name.encode("ascii"),
            float(value),
            mavutil.mavlink.MAV_PARAM_TYPE_REAL32
        )

    deadline = time.time() + 5

    with param_condition:
        while time.time() < deadline:
            if name in param_values:
                actual = param_values.pop(name)
                print(f"{name}: requested={value}, received={actual}")
                return abs(actual - float(value)) < 1.0

            param_condition.wait(timeout=0.25)

    print(f"Timeout waiting for {name}")
    return False

@app.post("/api/save")
def save():
    if not state["connected"]:
        raise HTTPException(503, "Pixhawk disconnected")
    if state["armed"]:
        raise HTTPException(400, "Vehicle must be disarmed")

    with lock:
        if state["phase"] != "trim":
            raise HTTPException(400, "Complete endpoint capture first")

        count = state["count"]
        mins = state["minimum"][:count]
        maxs = state["maximum"][:count]
        channels = state["channels"][:count]

        trims = []
        for i, (lo, hi) in enumerate(zip(mins, maxs)):
            # ArduCopter default channel mapping: throttle is channel 3.
            trim = lo if i == 2 else round((lo + hi) / 2)
            trims.append(trim)

        state["trim"] = trims

    results = []
    for i, (lo, hi, trim) in enumerate(zip(mins, maxs, trims), start=1):
        for suffix, value in [
            ("_MIN", lo),
            ("_MAX", hi),
            ("_TRIM", trim)
        ]:
            name = f"RC{i}{suffix}"
            try:
                ok = set_parameter(name, value)
            except Exception as e:
                ok = False
                print(name, e)

            results.append((name, value, ok))
            if not ok:
                raise HTTPException(
                    502,
                    f"Could not verify {name}. Calibration may be partially saved. Check Pixhawk connection."
                )

    with lock:
        state["phase"] = "done"
        state["saved"] = True
        state["message"] = "All captured RC parameters were acknowledged by the Pixhawk."

    print("Radio parameters verified:", results)
    return {"ok": True, "results": results}


def read_parameter(name, timeout=5):
    global master
    if master is None or not state["connected"]:
        raise HTTPException(503, "Pixhawk disconnected")

    with param_condition:
        param_values.pop(name, None)

    with send_lock:
        master.mav.param_request_read_send(
            master.target_system,
            master.target_component,
            name.encode("ascii"),
            -1
        )

    deadline = time.time() + timeout
    with param_condition:
        while time.time() < deadline:
            if name in param_values:
                return param_values.pop(name)
            param_condition.wait(timeout=0.25)

    raise HTTPException(504, f"No response for {name}")


@app.get("/api/settings")
def get_settings():
    values = {}
    for name in ["ARMING_SKIPCHK", "BRD_SAFETY_DEFLT", "RC6_OPTION"]:
        try:
            values[name] = read_parameter(name)
        except HTTPException:
            values[name] = None

    return {
        "connected": state["connected"],
        "arm_checks": values["ARMING_SKIPCHK"] == 0,
        "arm_checks_raw": values["ARMING_SKIPCHK"],
        "board_safety": values["BRD_SAFETY_DEFLT"] == 1,
        "rc6_arm": values["RC6_OPTION"] == 153,
        "raw": values
    }


@app.post("/api/settings/save")
def save_settings(data: dict):
    if not state["connected"] or master is None:
        raise HTTPException(503, "Pixhawk disconnected")
    if state["armed"]:
        raise HTTPException(400, "Disarm the vehicle first")

    changes = [
        ("ARMING_SKIPCHK", 0 if data["arm_checks"] else -1),
        ("BRD_SAFETY_DEFLT", 1 if data["board_safety"] else 0),
        ("RC6_OPTION", 153 if data["rc6_arm"] else 0)
    ]

    results = []
    for name, value in changes:
        ok = set_parameter(name, value)
        results.append({"parameter": name, "value": value, "verified": ok})
        if not ok:
            raise HTTPException(502, f"Could not verify {name}. Some settings may have been saved.")

    return {"success": True, "results": results, "reboot_required": True}


