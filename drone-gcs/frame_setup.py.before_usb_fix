import threading, time
from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from pymavlink import mavutil

PORT='/dev/ttyACM0'; BAUD=115200
app=FastAPI(title='Frame Setup')
master=None
state={'connected':False,'armed':False,'error':'Connecting to Pixhawk'}
values={}; condition=threading.Condition(); tx_lock=threading.Lock()

def norm(v):
    return v.decode('ascii','ignore').rstrip('\x00') if isinstance(v,(bytes,bytearray)) else str(v).rstrip('\x00')

def reader():
    global master
    while True:
        try:
            if master is None:
                state.update(connected=False,error='Connecting to Pixhawk')
                master=mavutil.mavlink_connection(PORT,baud=BAUD)
                master.wait_heartbeat(timeout=15)
                state.update(connected=True,error='')
            msg=master.recv_match(type=['HEARTBEAT','PARAM_VALUE'],blocking=True,timeout=2)
            if msg is None: continue
            if msg.get_type()=='HEARTBEAT':
                state['armed']=bool(msg.base_mode & mavutil.mavlink.MAV_MODE_FLAG_SAFETY_ARMED)
            elif msg.get_type()=='PARAM_VALUE':
                with condition:
                    values[norm(msg.param_id)]=float(msg.param_value)
                    condition.notify_all()
        except Exception as e:
            state.update(connected=False,error=str(e)); master=None; time.sleep(2)
threading.Thread(target=reader,daemon=True).start()

def read_param(name,timeout=4):
    if not master or not state['connected']: raise HTTPException(503,'Pixhawk is not connected')
    with condition:
        values.pop(name,None)
        with tx_lock: master.mav.param_request_read_send(master.target_system,master.target_component,name.encode(),-1)
        end=time.time()+timeout
        while time.time()<end:
            if name in values:return values[name]
            condition.wait(end-time.time())
    raise HTTPException(504,f'No PARAM_VALUE response for {name}')

def write_param(name,value,timeout=5):
    if not master or not state['connected']: raise HTTPException(503,'Pixhawk is not connected')
    with condition:
        values.pop(name,None)
        with tx_lock: master.mav.param_set_send(master.target_system,master.target_component,name.encode(),float(value),mavutil.mavlink.MAV_PARAM_TYPE_REAL32)
        end=time.time()+timeout
        while time.time()<end:
            if name in values:
                actual=values[name]
                if abs(actual-float(value))<0.01:return actual
                values.pop(name,None)
            condition.wait(end-time.time())
    raise HTTPException(504,f'No matching parameter acknowledgement for {name}')

@app.get('/api/status')
def status(): return {**state,'frame_class':values.get('FRAME_CLASS'),'frame_type':values.get('FRAME_TYPE')}

@app.get('/api/frame')
def get_frame():
    return {'connected':state['connected'],'armed':state['armed'],'FRAME_CLASS':read_param('FRAME_CLASS'),'FRAME_TYPE':read_param('FRAME_TYPE')}

@app.post('/api/frame/save')
def save_frame(data:dict):
    if state['armed']: raise HTTPException(409,'Disarm the aircraft before changing frame configuration')
    try: fc=int(data['frame_class']); ft=int(data['frame_type'])
    except Exception: raise HTTPException(400,'Invalid frame selection')
    # ArduCopter FRAME_CLASS: 0 undefined, 1 quad, 2 hexa, 3 octa, 4 octa-quad, 5 Y6, 6 helicopter, 7 tri, 8 singlecopter, 9 coaxcopter, 10-12 dodeca variants, 13 heli-dual, 14 tailsitter, 15 custom.
    if fc not in range(0,16): raise HTTPException(400,'Unsupported FRAME_CLASS value')
    if ft not in range(0,4): raise HTTPException(400,'Unsupported FRAME_TYPE value')
    a=write_param('FRAME_CLASS',fc); b=write_param('FRAME_TYPE',ft)
    # Verify with fresh PARAM_REQUEST_READ transactions.
    va=read_param('FRAME_CLASS'); vb=read_param('FRAME_TYPE')
    return {'success':True,'acknowledged':True,'verified':abs(va-fc)<0.01 and abs(vb-ft)<0.01,'FRAME_CLASS':va,'FRAME_TYPE':vb,'reboot_required':True,'message':'Both parameters acknowledged and read back. Reboot the flight controller for the frame change to take effect.'}

